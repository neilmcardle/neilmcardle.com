#!/bin/sh

echo "🔍 Running pre-commit checks..."

# 1. Scan staged file contents for secrets (not commit message)
echo "  Scanning for secrets..."
SECRETS_FOUND=0

# Check staged file contents only (not diff text)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

SECRET_PATTERNS=(
  "PRIVATE.KEY"
  "private_key.*="
  "password\s*[:=]"
  "api_key"
  "aws_access_key"
  "aws_secret"
  "token\s*[:=]"
  "secret\s*[:=]"
  "Authorization.*Bearer"
  "ANTHROPIC_API_KEY"
  "STRIPE_SECRET"
)

for file in $STAGED_FILES; do
  if [[ "$file" == *.js || "$file" == *.ts || "$file" == *.jsx || "$file" == *.tsx || "$file" == *.env* ]]; then
    for pattern in "${SECRET_PATTERNS[@]}"; do
      if grep -iE "$pattern" "$file" > /dev/null 2>&1; then
        echo "    ⚠️  WARNING: Potential secret in $file: $pattern"
        SECRETS_FOUND=1
      fi
    done
  fi
done

if [ $SECRETS_FOUND -eq 1 ]; then
  echo "    ❌ Commit blocked: Remove secrets before committing"
  exit 1
fi
echo "    ✓ No secrets detected"

# 2. Strip comments from staged files
echo "  Stripping comments..."
node "$(git rev-parse --show-toplevel)/scripts/strip-comments.js" 2>/dev/null

# 3. Run lint-staged for formatting
echo "  Running prettier..."
npx lint-staged

# 4. Run typecheck if script exists
if grep -q '"typecheck"' package.json; then
  echo "  Type checking..."
  npm run typecheck || { echo "    ❌ TypeScript errors found"; exit 1; }
fi

echo "✓ All pre-commit checks passed"
