# TypeSafe API key for Jev: the fast decisions behind every edit.
# Create one at console.typesafe.ai → API Keys. Required.
TYPESAFE_API_KEY=

# Anthropic API key: only needed to draft a card or hero from a spoken
# description ("a dark hero with my name and a trusted-by row"). Without it,
# speakui starts from the closest built-in pattern instead and says so.
ANTHROPIC_API_KEY=

# Optional overrides.
# JEV_MODEL=jev-latest
# COMPOSE_MODEL=claude-opus-5

# ---- Public demo (leave unset locally; set these on Vercel) ----
# Off unless exactly "1", so local development is never limited.
DEMO_MODE=1
# Edits one visitor gets before the composer freezes.
DEMO_VISITOR_EDITS=10
# Per-IP burst limit. Generous for a human, useless for a script.
DEMO_IP_PER_MINUTE=20
# The ceiling that actually protects the wallet: Jev calls per calendar month
# across the whole deployment. ~$0.00027 a call, so 40,000 is about $11.
DEMO_MONTHLY_CALLS=40000
