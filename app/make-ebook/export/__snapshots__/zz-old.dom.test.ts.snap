exports[`PDF > prints the same chapters with the book's stylesheet 1`] = `
"<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>The Lighthouse</title>
<style>
@charset "UTF-8";

html, body {
  margin: 0;
  padding: 0;
}

body {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 1em;
  line-height: 1.8;
  margin: 5%;
  text-align: justify;
  -webkit-hyphens: auto;
  hyphens: auto;
}

p {
  text-indent: 1.5em;
  margin-top: 0;
  margin-bottom: 0;
  orphans: 2;
  widows: 2;
}

.chapter-content > p:first-child,
h1 + p,
h2 + p,
h3 + p,
hr + p,
blockquote + p,
figure + p,
ul + p,
ol + p {
  text-indent: 0;
}

h1, h2, h3 {
  font-weight: bold;
  line-height: 1.3;
  page-break-after: avoid;
  break-after: avoid;
}

h1 {
  font-size: 1.5em;
  margin: 2em 0 1em;
}

h2 {
  font-size: 1.3em;
  margin: 1.5em 0 0.8em;
}

h3 {
  font-size: 1.1em;
  margin: 1.2em 0 0.6em;
}

.chapter-title {
  text-align: center;
  font-size: 1.5em;
  margin: 2em 0 1em;
}

.title-page {
  text-align: center;
  margin-top: 30%;
}

.title-page .book-title {
  font-size: 2em;
  margin: 0 0 0.5em;
}

.title-page .book-author {
  font-size: 1.2em;
  font-style: italic;
  text-indent: 0;
  margin: 0 0 0.3em;
}

.title-page .book-publisher {
  font-size: 0.9em;
  text-indent: 0;
  margin-top: 3em;
}

.details p {
  text-indent: 0;
  margin: 0 0 0.4em;
}

hr {
  border: none;
  text-align: center;
  margin: 1.5em 0;
}

hr::before {
  content: "* * *";
  letter-spacing: 0.5em;
  color: #666;
}

blockquote {
  margin: 1em 2em;
  font-style: italic;
}

blockquote p {
  text-indent: 0;
}

ul, ol {
  margin: 1em 0;
  padding-left: 2em;
}

ul {
  list-style-type: disc;
}

ol {
  list-style-type: decimal;
}

li {
  margin-bottom: 0.3em;
}

li p {
  text-indent: 0;
  margin: 0;
}

a {
  color: inherit;
  text-decoration: underline;
}

a.endnote-ref {
  text-decoration: none;
}

a.endnote-ref sup {
  font-size: 0.75em;
  line-height: 0;
}

a.endnote-back {
  font-size: 0.85em;
  margin-left: 0.5em;
  text-decoration: none;
}

nav ol {
  list-style-type: none;
  padding-left: 0;
}

nav a {
  text-decoration: none;
}

img {
  max-width: 100%;
  height: auto;
}

figure {
  margin: 1.5em 0;
  text-align: center;
}

figure img {
  display: block;
  margin: 0 auto;
}

figcaption {
  font-size: 0.9em;
  font-style: italic;
  margin-top: 0.5em;
}

pre, code {
  font-family: "Courier New", Courier, monospace;
  font-size: 0.9em;
}

pre {
  padding: 1em;
  white-space: pre-wrap;
  word-wrap: break-word;
  border: 1px solid #ddd;
}

@page {
  size: A5;
  margin: 2cm 1.8cm;
}

body {
  margin: 0;
  font-size: 11pt;
  color: #000;
}

.title-page,
.chapter {
  break-before: page;
  page-break-before: always;
}

.title-page {
  break-before: auto;
  page-break-before: auto;
  margin-top: 35%;
}

img,
figure,
pre {
  break-inside: avoid;
  page-break-inside: avoid;
}

</style>
</head>
<body>
<section class="title-page">
<h1 class="book-title">The Lighthouse</h1>
<p class="book-author">Mara Quill</p>
<p class="book-publisher">Quillmore Press</p>
</section>
<section class="chapter" id="chapter-1">
<h1 class="chapter-title">Dedication</h1>
<div class="chapter-content"><p>For my father, who kept the light.</p></div>
</section>
<section class="chapter" id="chapter-2">
<h1 class="chapter-title">The Light</h1>
<div class="chapter-content"><p>The keeper counted every ship that passed the rocks.</p><p style="text-align: center;">He wrote their names <em>in a ledger</em><a href="#end1" id="ref1" class="endnote-ref" epub:type="noteref"><sup>[1]</sup></a> the colour of <strong>wet slate</strong>.</p><hr /><blockquote><p>The sea is patient.</p></blockquote><h2>The log</h2><ul><li><p>Wind</p></li><li><p>Tide</p></li></ul><ol start="3"><li><p>Third</p></li><li><p>Fourth</p></li></ol><figure><img src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==" alt="The tower" /><figcaption>The tower at dusk</figcaption></figure><p>See <a href="https://example.com/tides">the tide tables</a> and <a href="#harbour-mark">the harbour</a>.</p></div>
</section>
<section class="chapter" id="chapter-3">
<h1 class="chapter-title">Chapter 2</h1>
<div class="chapter-content"><p><a id="harbour-mark"></a>The harbour master knew before anyone told him.</p></div>
</section>
<section class="chapter" id="chapter-4">
<h1 class="chapter-title">Endnotes</h1>
<div class="chapter-content"><p>1. Slate grey, from the quarry above the bay. <a href="#ref1" id="end1" class="endnote-back">[1]</a></p></div>
</section>
</body>
</html>
"
`;

