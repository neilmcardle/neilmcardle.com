exports[`EPUB > produces the same chapters as the golden copy > chapter2 1`] = `
"<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:epub="http://www.idpf.org/2007/ops" xml:lang="en" lang="en">
<head>
<meta charset="utf-8" />
<title>The Light</title>
<link rel="stylesheet" type="text/css" href="styles.css" />
</head>
<body>
<section epub:type="bodymatter chapter">
<h1 class="chapter-title">The Light</h1>
<div class="chapter-content"><p>The keeper counted every ship that passed the rocks.</p><p style="text-align: center;">He wrote their names <em>in a ledger</em><a href="chapter4.xhtml#end1" id="ref1" class="endnote-ref" epub:type="noteref"><sup>[1]</sup></a> the colour of <strong>wet slate</strong>.</p><hr /><blockquote><p>The sea is patient.</p></blockquote><h2>The log</h2><ul><li><p>Wind</p></li><li><p>Tide</p></li></ul><ol start="3"><li><p>Third</p></li><li><p>Fourth</p></li></ol><figure><img src="images/image1.png" alt="The tower" /><figcaption>The tower at dusk</figcaption></figure><p>See <a href="https://example.com/tides">the tide tables</a> and <a href="chapter3.xhtml#harbour-mark">the harbour</a>.</p></div>
</section>
</body>
</html>
"
`;

