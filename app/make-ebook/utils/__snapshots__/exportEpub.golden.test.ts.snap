exports[`EPUB export > produces the same chapter files as before 1`] = `
{
  "OEBPS/chapter1.xhtml": "<?xml version="1.0" encoding="utf-8"?>
      <html xmlns="http://www.w3.org/1999/xhtml">
        <head>
          <title>Dedication</title>
          <link rel="stylesheet" type="text/css" href="styles.css"/>
        </head>
        <body>
          <h1 class="chapter-title">Dedication</h1>
          <div class="chapter-content"><p>For everyone who tests.</p></div>
        </body>
      </html>",
  "OEBPS/chapter2.xhtml": "<?xml version="1.0" encoding="utf-8"?>
      <html xmlns="http://www.w3.org/1999/xhtml">
        <head>
          <title>Chapter 1</title>
          <link rel="stylesheet" type="text/css" href="styles.css"/>
        </head>
        <body>
          <h1 class="chapter-title">Chapter 1</h1>
          <div class="chapter-content"><p>It was a <strong>bright</strong> and <em>cold</em> day.</p><h2>A heading</h2><p>Second paragraph &amp; more.</p></div>
        </body>
      </html>",
  "OEBPS/chapter3.xhtml": "<?xml version="1.0" encoding="utf-8"?>
      <html xmlns="http://www.w3.org/1999/xhtml">
        <head>
          <title>The End &amp; After</title>
          <link rel="stylesheet" type="text/css" href="styles.css"/>
        </head>
        <body>
          <h1 class="chapter-title">The End &amp; After</h1>
          <div class="chapter-content"><p>Last words.</p><blockquote><p>A quote.</p></blockquote></div>
        </body>
      </html>",
  "OEBPS/nav.xhtml": "<?xml version="1.0" encoding="utf-8"?>
  <html xmlns="http://www.w3.org/1999/xhtml">
    <head>
      <title>Navigation</title>
    </head>
    <body>
      <nav epub:type="toc" id="toc">
        <h2>Table of Contents</h2>
        <ol>
          
          <li><a href="toc.xhtml">Table of Contents</a></li>
          <li><a href="publisher.xhtml">Publisher Page</a></li>
          <li><a href="chapter1.xhtml">Dedication</a></li>
<li><a href="chapter2.xhtml">Chapter 1</a></li>
<li><a href="chapter3.xhtml">The End &amp; After</a></li>
        </ol>
      </nav>
    </body>
  </html>",
  "OEBPS/publisher.xhtml": "<?xml version="1.0" encoding="utf-8"?>
    <html xmlns="http://www.w3.org/1999/xhtml">
      <head>
        <title>Publisher Page</title>
      </head>
      <body>
        <h2>Publisher Information</h2>
        <ul style="list-style-type: none; padding-left: 0;">
          <li><strong>Title:</strong> Tom &amp; Jerry&apos;s &lt;Big&gt; Day</li>
          <li><strong>Author:</strong> A. N. Author</li>
          <li><strong>Publisher:</strong> Quillmore Press</li>
          <li><strong>ISBN:</strong> 9780000000001</li>
          <li><strong>Publication Date:</strong> 2026-11-10</li>
          <li><strong>Language:</strong> en-GB</li>
          <li><strong>Description:</strong> A short book used to pin down what the exporter produces.</li>
          <li><strong>Tags/Subjects:</strong> Fiction, test, golden</li>
        </ul>
      </body>
    </html>",
  "OEBPS/toc.xhtml": "<?xml version="1.0" encoding="utf-8"?>
    <html xmlns="http://www.w3.org/1999/xhtml">
      <head>
        <title>Table of Contents</title>
      </head>
      <body>
        <h2>Table of Contents</h2>
        <ul style="list-style-type: none; padding-left: 0;">
          <li><a href="publisher.xhtml">Publisher Page</a></li>
          <li><a href="chapter1.xhtml">Dedication</a></li>
          <li><a href="chapter2.xhtml">Chapter 1</a></li>
          <li><a href="chapter3.xhtml">The End &amp; After</a></li>
        </ul>
      </body>
    </html>",
}
`;

