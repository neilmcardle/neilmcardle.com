exports[`EPUB export > produces the same package file as before 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
    <package xmlns="http://www.idpf.org/2007/opf" unique-identifier="BookId" version="3.0">
      <metadata xmlns:dc="http://purl.org/dc/elements/1.1/">
        <dc:identifier id="BookId">9780000000001</dc:identifier>
        <dc:title>Tom &amp; Jerry&apos;s &lt;Big&gt; Day</dc:title>
        <dc:language>en-GB</dc:language>
        <dc:creator>A. N. Author</dc:creator>
        <dc:description>A short book used to pin down what the exporter produces.</dc:description>
        <dc:publisher>Quillmore Press</dc:publisher>
        <dc:date>2026-11-10</dc:date>
        <dc:subject>Fiction</dc:subject>
          <dc:subject>test</dc:subject>
          <dc:subject>golden</dc:subject>
        
        <meta property="dcterms:modified">DATE</meta>
      </metadata>
      <manifest>
        
        <item id="chapter1" href="chapter1.xhtml" media-type="application/xhtml+xml"/>
      <item id="chapter2" href="chapter2.xhtml" media-type="application/xhtml+xml"/>
      <item id="chapter3" href="chapter3.xhtml" media-type="application/xhtml+xml"/>
        
        <item id="toc" href="toc.xhtml" media-type="application/xhtml+xml"/>
     <item id="publisher" href="publisher.xhtml" media-type="application/xhtml+xml"/>
        <item id="nav" href="nav.xhtml" media-type="application/xhtml+xml" properties="nav"/>
        <item id="styles" href="styles.css" media-type="text/css"/>
      </manifest>
      <spine toc="nav">
        <itemref idref="toc"/>
      <itemref idref="publisher"/>
      <itemref idref="chapter1"/>
      <itemref idref="chapter2"/>
      <itemref idref="chapter3"/>
      </spine>
    </package>"
`;
